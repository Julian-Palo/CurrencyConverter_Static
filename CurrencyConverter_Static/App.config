<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<connectionStrings>
		<!--must add connection string after making Currency_Master 
		data table in order to make it work-->
		<add name="ConnectionString"
     connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\Database\CurrencyConverter.mdf;Integrated Security=True"
     providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>