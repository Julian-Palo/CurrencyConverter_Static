<?xml version="1.0" encoding="utf-8" ?>
<!--Copy this file to secrets.config (same folder) and paste in your App ID.
Get a free one at https://openexchangerates.org/signup/free
secrets.config is in .gitignore, so your App ID never ends up on GitHub-->
<appSettings>
	<add key="OpenExchangeRatesAppId" value="YOUR_APP_ID_HERE" />
</appSettings>
